# ============================================
# SUPABASE - PROYECTO DEV
# ============================================
SUPABASE_URL_DEV=https://xxxxx.supabase.co
SUPABASE_ANON_KEY_DEV=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
DATABASE_URL_DEV=postgresql://postgres:[PASSWORD]@db.xxxxx.supabase.co:5432/postgres

# ============================================
# SUPABASE - PROYECTO PROD (opcional)
# ============================================
SUPABASE_URL_PROD=https://yyyyy.supabase.co
SUPABASE_ANON_KEY_PROD=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
DATABASE_URL_PROD=postgresql://postgres:[PASSWORD]@db.yyyyy.supabase.co:5432/postgres

# ============================================
# CONFIGURACIÓN
# ============================================
# Selección de proyecto: 'dev' o 'prod'
SUPABASE_PROJECT=dev

# Si no usas SUPABASE_PROJECT, define directamente:
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.xxxxx.supabase.co:5432/postgres

# Usuario por defecto cuando no hay JWT (solo desarrollo)
DEFAULT_USER_EMAIL=dev@cvlab.local
DEFAULT_USER_PASSWORD=dev-password

# Entorno y puerto
NODE_ENV=development
PORT=3000
